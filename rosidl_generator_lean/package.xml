<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rosidl_generator_lean</name>
  <version>0.1.0</version>
  <description>Generate the ROS interfaces in Lean 4.</description>
  <maintainer email="rmatheu@umd.edu">Ryan Matheu</maintainer>
  <license>Apache-2.0</license>

  <build_depend>rosidl_runtime_c</build_depend>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- Needed in the interface package's build, where the extension registered
       by rosidl_generator_lean-extras.cmake runs. -->
  <buildtool_export_depend>ament_cmake</buildtool_export_depend>
  <buildtool_export_depend>ament_cmake_python</buildtool_export_depend>
  <buildtool_export_depend>ament_index_python</buildtool_export_depend>
  <buildtool_export_depend>rcutils</buildtool_export_depend>
  <buildtool_export_depend>rosidl_cmake</buildtool_export_depend>
  <buildtool_export_depend>rosidl_generator_c</buildtool_export_depend>
  <buildtool_export_depend>rosidl_pycommon</buildtool_export_depend>
  <buildtool_export_depend>rosidl_runtime_lean</buildtool_export_depend>
  <buildtool_export_depend>rosidl_typesupport_c</buildtool_export_depend>
  <buildtool_export_depend>rosidl_typesupport_interface</buildtool_export_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rosidl_cli</exec_depend>
  <exec_depend>rosidl_generator_c</exec_depend>
  <exec_depend>rosidl_parser</exec_depend>
  <exec_depend>rosidl_pycommon</exec_depend>
  <exec_depend>rosidl_runtime_c</exec_depend>
  <exec_depend>rosidl_runtime_lean</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>rosidl_adapter</test_depend>
  <test_depend>rosidl_parser</test_depend>
  <test_depend>rosidl_pycommon</test_depend>

  <!-- Builds this generator before anything pulling in
       rosidl_default_generators, and is how rosidl_core_generators finds it. -->
  <member_of_group>rosidl_generator_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
